{
  "functions": {
    "api/bank.js": {
      "maxDuration": 30
    },
    "api/messages.js": {
      "maxDuration": 30
    },
    "api/statbel.js": {
      "maxDuration": 30
    },
    "api/system.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/bank/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/messages/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/system",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/messages/run-reminders",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/bank/account",
      "destination": "/api/bank?action=account"
    },
    {
      "source": "/api/bank/aspsps",
      "destination": "/api/bank?action=aspsps"
    },
    {
      "source": "/api/bank/callback",
      "destination": "/api/bank?action=callback"
    },
    {
      "source": "/api/bank/disconnect",
      "destination": "/api/bank?action=disconnect"
    },
    {
      "source": "/api/bank/start",
      "destination": "/api/bank?action=start"
    },
    {
      "source": "/api/bank/sync",
      "destination": "/api/bank?action=sync"
    },
    {
      "source": "/api/messages/send",
      "destination": "/api/messages?action=send"
    },
    {
      "source": "/api/messages/run-reminders",
      "destination": "/api/messages?action=run-reminders"
    },
    {
      "source": "/api/messages/webhook",
      "destination": "/api/messages?action=webhook"
    },
    {
      "source": "/api/messages/tracking",
      "destination": "/api/messages?action=tracking"
    },
    {
      "source": "/api/messages/open",
      "destination": "/api/messages?action=tracking&mode=open"
    },
    {
      "source": "/api/messages/view",
      "destination": "/api/messages?action=tracking&mode=view"
    },
    {
      "source": "/api/messages/copy",
      "destination": "/api/messages?action=tracking&mode=copy"
    },
    {
      "source": "/api/messages/inbound",
      "destination": "/api/messages?action=webhook"
    },
    {
      "source": "/api/statbel/health-index",
      "destination": "/api/statbel"
    }
  ],
  "framework": null,
  "buildCommand": "mkdir -p public/assets && cp index.html tenant-intake.html OPEN-ME-PROPERTY-MANAGER.html public/ && cp assets/managerent4u-logo.png assets/huurovereenkomst-template.docx public/assets/",
  "outputDirectory": "public"
}
